PORT=3000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:3001,http://localhost:3000

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server only. Bypasses RLS. Never expose it to the frontend or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-lite-latest

SUPABASE_STORAGE_BUCKET=resumes
MAX_RESUME_FILE_SIZE=5242880

# Background job worker (runs inside the API process)
WORKER_ENABLED=true
WORKER_CONCURRENCY=4
WORKER_POLL_MS=1500

# Local load tests only: deterministic fake AI. Ignored when NODE_ENV=production.
AI_MOCK_MODE=false
